// packages/db/prisma/schema.prisma — Storm
// Prisma 7: the connection URL lives in prisma.config.ts, the client uses the pg driver adapter.
// Conventions: primary keys are named `<entity>Id` (uuid), timestamps are
// `dateCreated` / `dateUpdated`, tables are PascalCase plural (@@map("Users")).
// Every user-owned table carries `userId` (single user for now; row-level security if it ever becomes multi-user).
// Child tables owned through their parent (PipelineVersions, Steps, Decisions) don't.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, citext]
}

// #region Enums

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_USER
  DONE
  FAILED
  ABORTED
}

enum StepStatus {
  PENDING
  RUNNING
  WAITING
  DONE
  FAILED
  SKIPPED
}

enum ProposalStatus {
  PREVIEW // dry run: shows what would be proposed, never executes
  PENDING_REVIEW
  APPROVED
  EXECUTING
  WAITING_FOR_USER
  DONE
  FAILED
  REJECTED
  EXPIRED
}

enum DecisionKind {
  APPROVED
  EDITED
  REJECTED
}

enum RuleStatus {
  SUGGESTED
  ACTIVE
  DISABLED
}

enum ReflectionStatus {
  SUBMITTED
  DONE
  FAILED
}

enum SuggestionStatus {
  OPEN
  DONE
  DISMISSED
}

enum CredentialKind {
  PASSWORD
  TOTP_SEED
  API_KEY
  OAUTH_TOKEN
  STORAGE_STATE
  DATABASE
}

enum JobPostingStatus {
  NEW
  SHORTLISTED
  SKIPPED
  APPLIED
}

enum ApplicationStatus {
  PREPARED
  SUBMITTED
  RESPONDED
  REJECTED
  INTERVIEW
}

// #endregion

// #region Identity

/// The owner of everything. Password hash and TOTP secret live in .env (single user, docs/design.md §14).
model User {
  userId      String   @id @default(uuid()) @db.Uuid
  email       String   @unique @db.Citext
  displayName String?
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  sessions         UserSession[]
  settings         UserSetting?
  followUps        FollowUp[]
  bills            Bill[]
  watched          WatchedProduct[]
  pipelines        Pipeline[]
  builderChats     BuilderChat[]
  siteRecipes      SiteRecipe[]
  runs             Run[]
  proposals        Proposal[]
  rules            Rule[]
  examples         Example[]
  credentials      Credential[]
  modelSettings    ModelSetting[]
  artifacts        Artifact[]
  jobPostings      JobPosting[]
  applications     Application[]
  documents        Document[]
  mailCursors      MailCursor[]
  reflections      Reflection[]
  suggestions      PipelineSuggestion[]
  webhooks         Webhook[]
  dataRecords      DataRecord[]
  apps             App[]
  dataPoints       DataPoint[]
  httpCaches       HttpCache[]
  alertStates      AlertState[]
  google           GoogleConnection?
  facts            Fact[]
  questions        Question[]
  topics           Topic[]
  topicLinks       TopicLink[]
  topicFacts       TopicFact[]
  topicChanges     TopicChange[]
  topicSources     TopicSource[]
  topicPassages    TopicPassage[]
  topicBackfills   TopicBackfill[]
  topicSuggestions TopicSuggestion[]
  topicCosts       TopicCost[]
  unlinkedEmails   UnlinkedEmail[]
  scheduled        ScheduledStart[]

  @@map("Users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model UserSession {
  userSessionId String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime
  lastSeenAt    DateTime?
  ipAddress     String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(500)
  dateCreated   DateTime  @default(now())

  @@index([userId])
  @@map("UserSessions")
}

/// Run-time controls (docs/design.md §2.2, §2.6, §5). One row per user, created on first change.
model UserSetting {
  userId                String    @id @db.Uuid
  user                  User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// Kill switch: no run starts or continues, no side effect executes.
  paused                Boolean   @default(false)
  pausedAt              DateTime?
  /// Step type → "N/day" | "N/hour": caps across all pipelines (a pipeline's own `limits` count only its runs).
  rateLimits            Json      @default("{}")
  /// Overrides LLM_MONTHLY_BUDGET_USD.
  monthlyBudgetUsd      Decimal?  @db.Decimal(10, 2)
  /// Facts about the user for application forms (name, contacts, location, work permit, notice period...), as they write them.
  profile               String?
  /// Approve and Reject on the Storm bot's messages (M12-T4); off: they only link to the inbox.
  telegramApprovals     Boolean   @default(true)
  /// Told on Telegram that 80% of the budget is spent, and that it is reached (M19-T2): once a month each.
  budgetWarnedAt        DateTime?
  budgetReachedAt       DateTime?
  /// The weekly review on Telegram, Sunday evening (M19-T4).
  weeklyReview          Boolean   @default(true)
  /// The morning brief on Telegram, every day at 07:30 (M25).
  morningBrief          Boolean   @default(true)
  /// The builder chat the user's plain messages to the Storm bot continue (M21); /new clears it.
  telegramBuilderChatId String?   @db.Uuid
  dateUpdated           DateTime  @updatedAt

  @@map("UserSettings")
}

// #endregion

// #region Pipelines

model Pipeline {
  pipelineId       String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// Unique per user among saved pipelines (M39-T1): a partial unique index in its migration, which Prisma can't express.
  name             String
  enabled          Boolean  @default(false) // runs on its schedule
  /// Keeps running when the monthly LLM budget is exhausted (docs/design.md §5).
  essential        Boolean  @default(false)
  currentVersionId String?  @db.Uuid
  dateCreated      DateTime @default(now())
  dateUpdated      DateTime @updatedAt

  versions     PipelineVersion[]
  builderChats BuilderChat[]
  mailCursors  MailCursor[]
  suggestions  PipelineSuggestion[]
  webhook      Webhook?
  scheduled    ScheduledStart[]
  alertStates  AlertState[]

  @@index([userId])
  @@map("Pipelines")
}

/// A pipeline's address on the Internet (M12-T2): POST /hooks/<webhookId> through the public hooks site. The secret is
/// shown once: kept sealed (AAD = webhookId) for the worker to check an hmac-sha256 signature, and as its SHA-256
/// for the api to check a bearer token without decrypting anything.
model Webhook {
  /// 32 random bytes, base64url: the unguessable part of the address.
  webhookId    String    @id
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId   String    @unique @db.Uuid
  pipeline     Pipeline  @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  secretHash   String    @db.VarChar(64)
  ciphertext   Bytes
  iv           Bytes
  authTag      Bytes
  wrappedDek   Bytes
  keyVersion   Int       @default(1)
  lastCalledAt DateTime?
  dateCreated  DateTime  @default(now())

  @@index([userId])
  @@map("Webhooks")
}

/// Where a pipeline's email.fetch stopped in a mailbox: messages with a higher UID are new. A new UIDVALIDITY (the
/// server renumbered the mailbox) starts over from the look-back window.
/// A product the user watches on the Prices page (M24): a target price, and the shops that sell it.
model WatchedProduct {
  watchedProductId String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name             String
  targetPrice      Decimal?       @db.Decimal(12, 2)
  /// The target's currency; a shop in another currency is never compared with it.
  currency         String?
  enabled          Boolean        @default(true)
  offers           WatchedOffer[]
  dateCreated      DateTime       @default(now())
  dateUpdated      DateTime       @updatedAt

  @@index([userId])
  @@map("WatchedProducts")
}

/// One shop's page for a watched product, with what price.watch read last. Its history is in DataPoint
/// (collection "price-watch", key: watchedOfferId).
model WatchedOffer {
  watchedOfferId   String         @id @default(uuid()) @db.Uuid
  watchedProductId String         @db.Uuid
  product          WatchedProduct @relation(fields: [watchedProductId], references: [watchedProductId], onDelete: Cascade)
  url              String
  /// The variant, as shop.product's select: { size: M, color: Black }.
  select           Json?
  lastPrice        Decimal?       @db.Decimal(12, 2)
  lastCurrency     String?
  lastInStock      Boolean?
  lastTitle        String?
  lastProblem      String?
  lastCheckedAt    DateTime?
  dateCreated      DateTime       @default(now())

  @@index([watchedProductId])
  @@map("WatchedOffers")
}

/// A bill read from an email or its PDF (M23, bill.save): one row per bill, however many emails mention it.
model Bill {
  billId      String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// Who bills, as the bill names it (e.g. "EVN Bulgaria").
  issuer      String
  /// The sender's domain: bills from one issuer are compared with each other by it.
  issuerKey   String
  /// issuerKey with the bill's reference, else its period, else its due date, else the email: the same bill again is
  /// the same row.
  billKey     String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String
  dueDate     DateTime? @db.Date
  /// The month it is for, YYYY-MM.
  period      String?
  reference   String?
  messageId   String
  from        String
  subject     String
  paidAt      DateTime?
  runId       String?   @db.Uuid
  dateCreated DateTime  @default(now())
  dateUpdated DateTime  @updatedAt

  @@unique([userId, billKey])
  @@index([userId, issuerKey])
  @@map("Bills")
}

/// One of the user's sent emails that email.awaiting proposed a follow-up for (M22): never proposed again, whatever they
/// decided. Another message of theirs in the thread is a new one to follow up.
model FollowUp {
  followUpId  String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// The Message-ID of the user's email that got no answer.
  messageId   String
  threadId    String
  to          String
  subject     String
  runId       String?  @db.Uuid
  dateCreated DateTime @default(now())

  @@unique([userId, messageId])
  @@map("FollowUps")
}

model MailCursor {
  mailCursorId String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId   String   @db.Uuid
  pipeline     Pipeline @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  mailbox      String
  uidValidity  BigInt
  lastUid      BigInt
  dateUpdated  DateTime @updatedAt

  @@unique([pipelineId, mailbox])
  @@index([userId])
  @@map("MailCursors")
}

model PipelineVersion {
  pipelineVersionId String    @id @default(uuid()) @db.Uuid
  pipelineId        String    @db.Uuid
  pipeline          Pipeline  @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  version           Int
  definition        Json // validated pipeline definition (trigger, steps, limits)
  policy            Json // compiled targets: static lists + provenance rules (docs/design.md §2.2), enforced at run time
  changeSummary     String? // human-readable diff summary
  builderChatId     String?   @db.Uuid
  dateCreated       DateTime  @default(now())
  /// Null: a draft (one per pipeline, numbered after the latest saved version). Drafts only ever get dry runs.
  savedAt           DateTime?

  runs Run[]

  @@unique([pipelineId, version])
  @@map("PipelineVersions")
}

/// A chat with the pipeline builder (docs/design.md §2.1, §2.5). Its model is fixed when it starts: Claude's thinking blocks
/// in the history are bound to the model that wrote them.
model BuilderChat {
  builderChatId String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId    String?   @db.Uuid // null while drafting a new pipeline
  pipeline      Pipeline? @relation(fields: [pipelineId], references: [pipelineId], onDelete: SetNull)
  /// M34: the App this chat changes (null: none).
  appId         String?   @db.Uuid
  app           App?      @relation(fields: [appId], references: [appId], onDelete: SetNull)
  model         String
  effort        String
  /// The system prompt the chat started with (catalog included), kept for its lifetime: earlier thinking blocks are
  /// bound to it. Null for chats from before it was kept: they get the current one.
  system        String?
  /// All tokens of the chat's calls, failed turns included: the per-chat cap (BUILDER_CHAT_MAX_TOKENS).
  tokensUsed    Int       @default(0)
  dateCreated   DateTime  @default(now())
  dateUpdated   DateTime  @updatedAt

  messages BuilderMessage[]

  @@index([userId, pipelineId])
  @@map("BuilderChats")
}

/// One message of a builder chat: what the user wrote, or the builder's whole turn (its tool calls included).
model BuilderMessage {
  builderMessageId String      @id @default(uuid()) @db.Uuid
  builderChatId    String      @db.Uuid
  chat             BuilderChat @relation(fields: [builderChatId], references: [builderChatId], onDelete: Cascade)
  role             String // user | assistant
  text             String
  /// The API messages this one adds to the conversation, exactly as sent and received. Null for a failed turn: it
  /// and the message before it are left out of what the model sees.
  transcript       Json?
  /// Assistant: the definition it proposed (source, compiled definition and policy, status).
  proposal         Json?
  /// Assistant: compile errors of its last attempt when it ended without a valid proposal.
  compileErrors    Json?
  error            String?
  /// User: the reflection suggestion this message asks to apply.
  suggestionId     String?     @db.Uuid
  llmUsage         Json?
  dateCreated      DateTime    @default(now())

  @@index([builderChatId, dateCreated])
  @@map("BuilderMessages")
}

model SiteRecipe {
  siteRecipeId    String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  site            String // host, e.g. "jobs.bg"
  name            String // e.g. "jobs.bg/search"
  version         Int
  steps           Json // the recipe (@realentity/storm-steps RecipeSchema): selectors, fields, paging
  // Last run that read items with it (browser.extract or teach mode).
  lastVerifiedAt  DateTime?
  // The page stopped matching it; cleared when it works again or a new version is saved.
  brokenAt        DateTime?
  brokenReason    String?
  // Last run that found items with it (lastVerifiedAt also counts its "no results" page); M18-T2.
  lastItemsAt     DateTime?
  // Told that it has found nothing for a week (M18-T2); cleared when it finds items again.
  quietToldAt     DateTime?
  // The teach-mode run that made it; null: imported.
  taughtInRunId   String?   @db.Uuid
  // A fix browser.extract's fallback found when this version broke (M11-T3), waiting for the user: approved, it is saved
  // as the next version; until then runs read with it only when this one still fails.
  proposed        Json?
  proposedAt      DateTime?
  proposedInRunId String?   @db.Uuid
  dateCreated     DateTime  @default(now())

  @@unique([userId, name, version])
  @@map("SiteRecipes")
}

// #endregion

// #region Runs

model Run {
  runId             String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineVersionId String          @db.Uuid
  pipelineVersion   PipelineVersion @relation(fields: [pipelineVersionId], references: [pipelineVersionId])
  trigger           String // schedule, manual, event, webhook, telegram, dry-run
  /// {{trigger.*}}: the event's data or the webhook call (M12).
  triggerData       Json?
  /// How deep in a chain of runs started by events: 0 unless an event started it (chains stop at 3).
  chainDepth        Int             @default(0)
  /// The run whose event started this one.
  triggeredByRunId  String?         @db.Uuid
  dryRun            Boolean         @default(false)
  /// M37-T3: a dry run that stops after this step: the steps after it don't run.
  stopAfter         String?
  status            RunStatus       @default(QUEUED)
  headed            Boolean         @default(false)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  /// Held back by a rate limit: the next side-effect step may run from this time.
  resumeAt          DateTime?
  summary           String?

  steps     Step[]
  proposals Proposal[]
  artifacts Artifact[]
  takeovers Takeover[]
  questions Question[]

  @@index([userId, status])
  @@map("Runs")
}

/// The live browser waits for the user (docs/design.md §6): OPEN when the worker met a blocking state, TAKEN_OVER when
/// they took over on their own; CONTINUED or ABORTED when they pressed the button; EXPIRED when nobody did in time
/// or the worker restarted.
enum TakeoverStatus {
  OPEN
  TAKEN_OVER
  CONTINUED
  ABORTED
  EXPIRED
}

/// A pause of a headed step with its page kept open, for the user to act in the live view.
model Takeover {
  takeoverId  String         @id @default(uuid()) @db.Uuid
  runId       String         @db.Uuid
  run         Run            @relation(fields: [runId], references: [runId], onDelete: Cascade)
  stepKey     String?
  itemIndex   Int?
  status      TakeoverStatus
  /// Why: "CAPTCHA", "2FA prompt", "taken over", …
  reason      String
  /// The page it stopped on.
  url         String?
  /// What it waits for besides Continue (M14): "google", a Google reconnect, which continues it.
  waitsFor    String?
  requestedAt DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([runId, status])
  @@map("Takeovers")
}

model Step {
  stepId     String     @id @default(uuid()) @db.Uuid
  runId      String     @db.Uuid
  run        Run        @relation(fields: [runId], references: [runId], onDelete: Cascade)
  stepKey    String // id from the definition, e.g. "score"
  itemIndex  Int? // for forEach fan-out
  type       String // e.g. "llm.score"
  status     StepStatus @default(PENDING)
  input      Json?
  output     Json?
  llmUsage   Json? // model, input/output/cached tokens
  screenshot String?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  proposals Proposal[]

  @@index([runId])
  @@map("Steps")
}

model Proposal {
  proposalId         String         @id @default(uuid()) @db.Uuid
  userId             String         @db.Uuid
  user               User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  runId              String         @db.Uuid
  run                Run            @relation(fields: [runId], references: [runId], onDelete: Cascade)
  stepId             String         @db.Uuid // the gate step that created it
  step               Step           @relation(fields: [stepId], references: [stepId], onDelete: Cascade)
  stepKey            String // the step to act (gate.act) or the review step itself (gate.review)
  itemIndex          Int? // forEach item this proposal belongs to
  status             ProposalStatus @default(PENDING_REVIEW)
  target             String // email address / URL / site
  targets            Json? // per target: field, value, kind, basis (static | provenance) and whether it is new
  /// Targets outside the static lists that the user explicitly approved with this proposal ("New domain: X").
  approvedNewTargets String[]       @default([])
  originalPayload    Json
  finalPayload       Json?
  payloadHash        String?        @db.VarChar(64) // SHA-256 of the approved payload
  reasoning          String? // short LLM explanation shown in the UI
  dateCreated        DateTime       @default(now())
  expiresAt          DateTime?
  /// The Storm bot told the user about it (M12-T4), in this message (edited once it's decided).
  notifiedAt         DateTime?
  telegramMessageId  Int?

  decision Decision?

  @@index([userId, status])
  @@index([runId])
  @@map("Proposals")
}

model Decision {
  decisionId String       @id @default(uuid()) @db.Uuid
  proposalId String       @unique @db.Uuid
  proposal   Proposal     @relation(fields: [proposalId], references: [proposalId], onDelete: Cascade)
  kind       DecisionKind
  diff       Json?
  reason     String?
  decidedAt  DateTime     @default(now())

  @@map("Decisions")
}

model Artifact {
  artifactId  String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  runId       String?  @db.Uuid
  run         Run?     @relation(fields: [runId], references: [runId], onDelete: SetNull)
  kind        String // screenshot, trace, download, upload, cv
  /// The step that made it, if any.
  stepKey     String?
  itemIndex   Int?
  /// Relative to the artifacts folder (ARTIFACTS_DIR).
  path        String
  size        Int?
  mime        String?
  sha256      String?  @db.VarChar(64)
  dateCreated DateTime @default(now())

  @@index([userId])
  @@index([runId])
  @@map("Artifacts")
}

// #endregion

// #region Learning

model Rule {
  ruleId      String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  stepType    String? // e.g. "email.draftReply"; null = global
  pipelineId  String?    @db.Uuid // optional: rule only for one pipeline
  text        String
  /// Why reflection suggested it (the edits it is based on).
  rationale   String?
  status      RuleStatus @default(SUGGESTED)
  source      String? // "reflection:<reflectionId>" or "manual"
  dateCreated DateTime   @default(now())
  dateUpdated DateTime   @updatedAt

  @@index([userId, status])
  @@map("Rules")
}

model Example {
  exampleId      String                       @id @default(uuid()) @db.Uuid
  userId         String                       @db.Uuid
  user           User                         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  stepType       String
  pipelineId     String?                      @db.Uuid // optional: example only for one pipeline
  context        String
  output         String
  embedding      Unsupported("vector(1024)")? // dimension depends on the embedding model
  /// The model that made `embedding`: only vectors of the current model are compared.
  embeddingModel String?
  proposalId     String?                      @db.Uuid
  dateCreated    DateTime                     @default(now())

  @@unique([proposalId, stepType])
  @@index([userId, stepType])
  @@map("Examples")
}

/// A nightly reflection (docs/design.md §8): the user's recent edits and rejections, sent to Claude as a batch; its
/// answer becomes SUGGESTED rules and pipeline suggestions, never active ones.
model Reflection {
  reflectionId String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  status       ReflectionStatus @default(SUBMITTED)
  batchId      String?
  /// The decisions it covers: decidedAt in [since, until).
  since        DateTime
  until        DateTime
  decisions    Int
  /// The edited replies shown with their topics (M44-T3): [{ index, proposalId, subject, decidedAt, topics: [{ topicId, name }] }].
  edits        Json             @default("[]")
  /// The unlinked emails shown (M44-T2), by index: [{ messageId, from, subject, date }].
  unlinked     Json             @default("[]")
  llmUsage     Json?
  error        String?
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  @@index([userId, startedAt])
  @@map("Reflections")
}

/// A change to a pipeline that reflection suggests; the builder chat (M7) turns it into a definition diff.
model PipelineSuggestion {
  suggestionId String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId   String           @db.Uuid
  pipeline     Pipeline         @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  text         String
  rationale    String?
  status       SuggestionStatus @default(OPEN)
  source       String? // "reflection:<reflectionId>"
  dateCreated  DateTime         @default(now())

  @@index([userId, status])
  @@map("PipelineSuggestions")
}

// #endregion

// #region Secrets & settings

/// Envelope-encrypted secret (docs/design.md §7). `credentialId` is generated before insert: it is the AAD.
model Credential {
  credentialId String         @id @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name         String // referenced as {{cred:<name>}}
  allowedHosts String[] // e.g. ["linkedin.com", "*.linkedin.com"]
  username     String?
  kind         CredentialKind
  ciphertext   Bytes
  iv           Bytes
  authTag      Bytes
  wrappedDek   Bytes // iv(12) + tag(16) + encrypted DEK(32)
  keyVersion   Int            @default(1)
  lastUsedAt   DateTime?
  dateCreated  DateTime       @default(now())
  dateUpdated  DateTime       @updatedAt

  @@unique([userId, name])
  @@map("Credentials")
}

model ModelSetting {
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  taskKey     String // e.g. "builder", "email.draftReply", "llm.score"
  model       String // e.g. "claude-sonnet-5-5"
  effort      String?
  dateUpdated DateTime @updatedAt

  @@id([userId, taskKey])
  @@map("ModelSettings")
}

// #endregion

// #region Jobs

model JobPosting {
  jobPostingId String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  source       String
  externalId   String?
  url          String
  title        String
  company      String?
  location     String?
  description  String           @default("")
  score        Float?
  scoreReason  String?
  status       JobPostingStatus @default(NEW)
  firstSeenAt  DateTime         @default(now())
  lastSeenAt   DateTime         @default(now())
  dateUpdated  DateTime         @updatedAt

  applications Application[]

  @@unique([userId, url])
  @@index([userId, status])
  @@map("JobPostings")
}

model Application {
  applicationId String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  user          User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  jobPostingId  String            @db.Uuid
  jobPosting    JobPosting        @relation(fields: [jobPostingId], references: [jobPostingId], onDelete: Cascade)
  proposalId    String?           @db.Uuid
  status        ApplicationStatus @default(PREPARED)
  cvArtifactId  String?           @db.Uuid
  /// The run that prepared or submitted it.
  runId         String?           @db.Uuid
  submittedAt   DateTime?
  /// When the employer first answered, invited the user to an interview, turned them down (M16): kept when the status moves
  /// on, so an interview that ended in a rejection still counts as an interview.
  respondedAt   DateTime?
  interviewAt   DateTime?
  rejectedAt    DateTime?
  notes         String?
  dateCreated   DateTime          @default(now())
  dateUpdated   DateTime          @updatedAt

  @@unique([jobPostingId])
  @@index([userId])
  @@map("Applications")
}

/// A file of the user's that application forms may attach (their CV, a cover letter), under DOCUMENTS_DIR. Uploading one
/// with the same name replaces it: the old row keeps its file (an approved payload names it by id and SHA-256) and
/// gets replacedAt.
model Document {
  documentId  String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name        String // e.g. "cv-main"
  filename    String // as uploaded, made safe
  mime        String
  size        Int
  sha256      String    @db.VarChar(64)
  /// Relative to DOCUMENTS_DIR.
  path        String
  replacedAt  DateTime?
  dateCreated DateTime  @default(now())

  @@index([userId, name])
  @@map("Documents")
}

// #endregion

// #region System

/// Liveness of a long-running process (the worker): it writes every 30 s; the api alerts when it goes stale.
/// Not user data, so no userId.
/// What the server's own jobs reported (M26): the nightly backup, the monthly restore test, disk and failed services.
/// A report that is not ok, or one that stops coming (older than maxAgeHours), is a problem: told once, and once
/// when it is fine again.
model HealthCheck {
  name        String    @id
  ok          Boolean
  detail      String
  reportedAt  DateTime
  maxAgeHours Int
  /// The last state told on Telegram: each change is told once.
  toldProblem Boolean   @default(false)
  toldAt      DateTime?

  @@map("HealthChecks")
}

model ServiceHeartbeat {
  service    String   @id
  startedAt  DateTime
  lastSeenAt DateTime

  @@map("ServiceHeartbeats")
}

// #endregion

// #region Data (M13)

/// An item data.save keeps in a collection of the user's, by its key: what it looked like last, for added / changed /
/// removed next time.
model DataRecord {
  dataRecordId String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  collection   String
  key          String
  value        Json
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Missing from a complete save; back when it appears again.
  removedAt    DateTime?
  /// The user's (M27): mark id → when they set it on the row's page. data.save never writes it.
  marks        Json      @default("{}")

  @@unique([userId, collection, key])
  @@map("DataRecords")
}

/// An App (M30): what belongs together (Job Search, Bills), with its data types. Its pipelines name it (`app:`).
model App {
  appId            String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name             String
  currentVersionId String?  @db.Uuid
  /// M40: { id, needs }: the example it was installed from; its App page shows a checklist of what is left (M40-T3).
  example          Json?
  dateCreated      DateTime @default(now())
  dateUpdated      DateTime @updatedAt

  versions     AppVersion[]
  entities     DataEntity[]
  builderChats BuilderChat[]

  @@unique([userId, name])
  @@map("Apps")
}

/// A saved version of an App's definition; immutable, a change is a new one.
model AppVersion {
  appVersionId  String   @id @default(uuid()) @db.Uuid
  appId         String   @db.Uuid
  app           App      @relation(fields: [appId], references: [appId], onDelete: Cascade)
  version       Int
  definition    Json // AppDefinition: name, icon, types (jsonb: its keys reordered)
  /// The YAML as written: the fields' order and its comments. What the App is read from (readAppSource).
  source        String
  changeSummary String?
  /// M39-T2: AppRefs: the pipelines its buttons run, by id, as resolved when it was saved. Null before M39.
  refs          Json?
  dateCreated   DateTime @default(now())

  @@unique([appId, version])
  @@map("AppVersions")
}

/// An entity of an App's type (M30): what pipelines write with data.save { type }, by the type's key.
model DataEntity {
  dataEntityId String    @id @default(uuid()) @db.Uuid
  appId        String    @db.Uuid
  app          App       @relation(fields: [appId], references: [appId], onDelete: Cascade)
  type         String
  key          String
  /// What pipelines wrote, each field as its kind; fields the type doesn't name kept as they came.
  value        Json
  /// The user's fields (M32's forms), by name; data.save never writes them.
  mine         Json      @default("{}")
  /// Its stage (M32), moved as the type's moves allow; null for a type without stages.
  stage        String?
  /// State → when it first reached it.
  stageDates   Json      @default("{}")
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Missing from a complete save; back when it appears again.
  removedAt    DateTime?

  @@unique([appId, type, key])
  @@map("DataEntities")
}

/// One value of data.history: a number per key over time (prices, counts).
model DataPoint {
  dataPointId String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  collection  String
  key         String
  value       Float
  at          DateTime @default(now())

  @@index([userId, collection, key, at])
  @@map("DataPoints")
}

/// data.alert (M29): what is past its line now, per pipeline, step and key. The row goes when it is back.
model AlertState {
  alertStateId String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId   String   @db.Uuid
  pipeline     Pipeline @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  stepKey      String
  key          String
  /// The value that crossed the line.
  value        Float
  since        DateTime @default(now())

  @@unique([pipelineId, stepKey, key])
  @@index([userId])
  @@map("AlertStates")
}

/// What http.fetch read last from an address, with its ETag / Last-Modified: a 304 reuses it.
model HttpCache {
  httpCacheId  String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  url          String
  etag         String?
  lastModified String?
  contentType  String
  body         Bytes
  fetchedAt    DateTime @default(now())

  @@unique([userId, url])
  @@map("HttpCaches")
}

// #endregion

enum GoogleConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
}

/// The user's Google account for the calendar steps (M14-T1): the refresh token sealed (AAD = userId), the state as last seen
/// when the calendar was used (no background checks).
model GoogleConnection {
  userId       String                 @id @db.Uuid
  user         User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  email        String
  scopes       String[]
  status       GoogleConnectionStatus @default(CONNECTED)
  ciphertext   Bytes
  iv           Bytes
  authTag      Bytes
  wrappedDek   Bytes
  keyVersion   Int                    @default(1)
  lastWorkedAt DateTime?
  brokenAt     DateTime?
  brokenReason String?
  dateCreated  DateTime               @default(now())
  dateUpdated  DateTime               @updatedAt

  @@map("GoogleConnections")
}

enum ScheduledStartStatus {
  PENDING
  STARTED
  CANCELLED
  SKIPPED
}

/// A pipeline to start later with data (flow.later, M14-T3): one start, unless cancelled by its key (flow.cancel) or
/// by an event matching `cancelOn` first.
model ScheduledStart {
  scheduledStartId String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  user             User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pipelineId       String               @db.Uuid
  pipeline         Pipeline             @relation(fields: [pipelineId], references: [pipelineId], onDelete: Cascade)
  /// Another flow.later with the same key replaces this one; flow.cancel cancels by it.
  key              String?
  data             Json
  /// { event, match }: that event with these values cancels it.
  cancelOn         Json?
  fireAt           DateTime
  status           ScheduledStartStatus @default(PENDING)
  /// Why it was cancelled or skipped.
  reason           String?
  scheduledByRunId String?              @db.Uuid
  runId            String?              @db.Uuid
  dateCreated      DateTime             @default(now())
  dateUpdated      DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, key])
  @@map("ScheduledStarts")
}

enum FactSource {
  /// A form answer the user approved at a gate: filled in or edited by them.
  FORM
  /// The user's answer to a question a run asked them.
  ASKED
  /// Written on the Profile page.
  ME
}

/// Something about the user only they can say (M15): a question as forms ask it and their answer. Only their
/// approvals, their answers and the Profile page write facts; never a page or the LLM alone. Form steps use them
/// before writing anything new.
model Fact {
  factId      String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// The question as the user last saw it, e.g. "Salary expectation".
  question    String
  /// The question normalized (lowercase, no punctuation): one fact per question.
  key         String
  answer      String
  source      FactSource
  /// The site whose form asked it, when it came from one.
  site        String?
  proposalId  String?    @db.Uuid
  runId       String?    @db.Uuid
  /// Times a form step proposed it, and the last one.
  uses        Int        @default(0)
  lastUsedAt  DateTime?
  dateCreated DateTime   @default(now())
  dateUpdated DateTime   @updatedAt

  @@unique([userId, key])
  @@map("Facts")
}

enum QuestionStatus {
  OPEN
  ANSWERED
  EXPIRED
}

/// A question a run asked the user (M15-T3), on Telegram (a reply answers it) and on the run page; the run waits for it.
model Question {
  questionId        String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  runId             String         @db.Uuid
  run               Run            @relation(fields: [runId], references: [runId], onDelete: Cascade)
  stepKey           String
  itemIndex         Int?
  question          String
  /// A select's or radio's choices: the answer must be one of them.
  options           String[]
  site              String?
  status            QuestionStatus @default(OPEN)
  answer            String?
  /// The Telegram message it was asked in: a reply to it is the answer.
  telegramMessageId Int?
  factId            String?        @db.Uuid
  dateCreated       DateTime       @default(now())
  answeredAt        DateTime?

  @@index([userId, status])
  @@index([telegramMessageId])
  @@map("Questions")
}

enum TopicStatus {
  ACTIVE
  /// Ended: matches no new email, keeps what it knows.
  ARCHIVED
}

enum TopicDirectionKind {
  /// A word or name in the subject or text ("Orion"), whole words, any case.
  WORD
  /// Anyone at a domain (`client.example`), its subdomains too.
  DOMAIN
  /// One address; with `about`, only when the email is about that (judged by the LLM).
  PERSON
  /// In plain words ("emails about the payment integration"), judged by the LLM.
  TEXT
}

/// A subject Storm keeps a memory of (M41, docs/design.md §8.1): what belongs to it is said by its directions.
model Topic {
  topicId     String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name        String            @db.Citext
  /// A few lines the user writes: what the subject is.
  description String            @default("")
  status      TopicStatus       @default(ACTIVE)
  directions  TopicDirection[]
  links       TopicLink[]
  facts       TopicFact[]
  changes     TopicChange[]
  sources     TopicSource[]
  passages    TopicPassage[]
  backfills   TopicBackfill[]
  suggestions TopicSuggestion[]
  costs       TopicCost[]
  dateCreated DateTime          @default(now())
  dateUpdated DateTime          @updatedAt

  @@unique([userId, name])
  @@map("Topics")
}

/// What belongs to a topic (M41-T2): written by the user only (or a suggestion they approved, M44).
model TopicDirection {
  topicDirectionId String             @id @default(uuid()) @db.Uuid
  topicId          String             @db.Uuid
  topic            Topic              @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  kind             TopicDirectionKind
  /// The word, the domain, the address or the plain words.
  value            String
  /// PERSON only: what the email must be about ("the API").
  about            String?
  dateCreated      DateTime           @default(now())

  @@index([topicId])
  @@map("TopicDirections")
}

enum TopicLinkStatus {
  /// An exact direction or the thread said so: linked, shown on the email.
  LINKED
  /// Only the LLM thinks so: waits for the user.
  SUGGESTED
  /// The user said so (confirmed, or moved it here).
  CONFIRMED
  /// The user said no: never suggested again for this email.
  REJECTED
}

enum TopicLinkVia {
  DIRECTION
  THREAD
  LLM
  USER
}

/**
 * An email and a topic it belongs to (M41-T3, docs/design.md §8.1): one per email and topic, an email in none, one or
 * several. The email's ids, sender, subject and date only, not its text (read from the mailbox when needed).
 */
model TopicLink {
  topicLinkId String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId     String          @db.Uuid
  topic       Topic           @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  messageId   String
  threadId    String
  from        String
  subject     String
  date        DateTime
  status      TopicLinkStatus
  via         TopicLinkVia
  /// What shows it: the direction that matched, the thread, or the line the LLM quoted.
  evidence    String
  runId       String?         @db.Uuid
  dateCreated DateTime        @default(now())
  dateUpdated DateTime        @updatedAt

  @@unique([topicId, messageId])
  @@index([userId, status])
  @@index([userId, threadId])
  @@index([userId, messageId])
  @@map("TopicLinks")
}

enum TopicFactStatus {
  /// What is true now: drafts use it.
  CURRENT
  /// It was true; a newer fact (supersededById) or the user said it no longer is. Kept as history.
  SUPERSEDED
  /// Sources disagree: the user decides which one holds.
  DISPUTED
  /// The user said it never was: hidden, and kept so the same source doesn't propose it again.
  WRONG
}

enum TopicFactSource {
  /// An email (sourceId: its Message-ID).
  EMAIL
  /// The user wrote it.
  USER
  /// A file of a topic's source (sourceId: "owner/repo:path@commit").
  FILE
}

/**
 * What is true about a topic (M42-T1, docs/design.md §8.1), each with its source and the date of that source. Not the
 * facts about the user (Fact, M15). Written only by the user or by a proposal they approved.
 */
model TopicFact {
  topicFactId    String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId        String          @db.Uuid
  topic          Topic           @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  /// What it is about, short ("Launch date"): facts about the same thing replace each other.
  about          String
  statement      String
  source         TopicFactSource
  /// EMAIL: the Message-ID.
  sourceId       String?
  /// Who and what, to show: "Maria <maria@client.example>: Kickoff".
  sourceLabel    String
  sourceDate     DateTime
  /// The source's own words that show it.
  quote          String          @default("")
  status         TopicFactStatus @default(CURRENT)
  supersededById String?         @db.Uuid
  supersededBy   TopicFact?      @relation("TopicFactSuperseded", fields: [supersededById], references: [topicFactId], onDelete: SetNull)
  supersedes     TopicFact[]     @relation("TopicFactSuperseded")
  /// The user wrote, edited or settled it: later evidence can only propose a conflict.
  pinned         Boolean         @default(false)
  /// M44-T9: made when a draft first needs it (more facts than fit), by embeddingModel, of embeddingOf ("about: statement"):
  /// a fact whose text changed since is embedded again.
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddingOf    String?
  runId          String?         @db.Uuid
  dateCreated    DateTime        @default(now())
  dateUpdated    DateTime        @updatedAt

  @@index([topicId, status])
  @@index([userId, sourceId])
  @@map("TopicFacts")
}

enum TopicChangeKind {
  ADD
  EDIT
  NO_LONGER_TRUE
  WRONG
  MOVE
  SETTLE
  /// A proposal approved at a gate (topic.apply).
  APPLY
  /// Part of a topic moved to a new one (M44-T4); otherTopicId: the new one.
  SPLIT
  /// A topic merged into this one (M44-T4); otherTopicId: the one merged (archived).
  MERGE
}

/**
 * A change to a topic's facts (M42-T1), with each fact before and after it, so it can be undone. `facts`:
 * [{ topicFactId, before, after }] (a snapshot or null); `links`: [{ topicLinkId, before }] of email links it made or
 * changed.
 */
model TopicChange {
  topicChangeId String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId       String          @db.Uuid
  topic         Topic           @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  /// MOVE: where to.
  otherTopicId  String?         @db.Uuid
  kind          TopicChangeKind
  /// One line: "Launch date: February → March".
  summary       String
  facts         Json
  links         Json            @default("[]")
  /// SPLIT, MERGE: [{ table: direction | source | link | topic, id, from, to }] (a topic id, or a topic's status).
  moves         Json            @default("[]")
  runId         String?         @db.Uuid
  undoneAt      DateTime?
  dateCreated   DateTime        @default(now())

  @@index([topicId, dateCreated])
  @@index([userId, otherTopicId])
  @@map("TopicChanges")
}

enum TopicSourceKind {
  /// A GitHub repository: files under a path, read at the branch's head.
  GITHUB
  /// An email's attachment (location: the Message-ID; path: the file name): read once, it never changes.
  ATTACHMENT
  /// A Google Drive folder and its subfolders (location: the folder's id), read through the user's Google connection.
  DRIVE
}

/**
 * Where a topic's documents live (M43, docs/design.md §8.1): linked, never copied. Storm keeps where it is and how far
 * it has read; the passages it indexes from it are a cache.
 */
model TopicSource {
  topicSourceId String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId       String          @db.Uuid
  topic         Topic           @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  kind          TopicSourceKind
  /// GITHUB: owner/repo. DRIVE: the folder's id.
  location      String
  /// GITHUB: the branch; null: the repository's default.
  branch        String?
  /// Which files: a glob ("docs/adr/**", "**/*.md").
  path          String          @default("**")
  /// A credential's name: a read-only token for the host (allowedHosts api.github.com); null for a public repository.
  credential    String?
  /// ATTACHMENT: where its email is, to read it again (a rebuild).
  mailbox       String?
  uid           Int?
  /// ATTACHMENT: what to show, "Maria <maria@client.example>: Kickoff". DRIVE: the folder's name, as last read.
  title         String          @default("")
  /// The last commit indexed (ATTACHMENT: "read"; DRIVE: Drive's changes page token): the next read continues from it.
  /// Null: not read yet.
  cursor        String?
  readAt        DateTime?
  passages      TopicPassage[]
  dateCreated   DateTime        @default(now())

  @@index([topicId])
  @@map("TopicSources")
}

/**
 * A passage of a source's file (M43-T3): the index, a cache. Refreshed when its file changes, rebuilt on request,
 * deleted without losing anything.
 */
model TopicPassage {
  topicPassageId String                       @id @default(uuid()) @db.Uuid
  userId         String                       @db.Uuid
  user           User                         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId        String                       @db.Uuid
  topic          Topic                        @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  topicSourceId  String                       @db.Uuid
  source         TopicSource                  @relation(fields: [topicSourceId], references: [topicSourceId], onDelete: Cascade)
  path           String
  /// DRIVE: the file's id, which a rename or a move keeps (its path is the folder's path to it).
  documentId     String?
  /// The commit it was read at (DRIVE: the file's version).
  ref            String
  /// When that commit was made: the passage's date as evidence.
  refDate        DateTime
  /// The headings it is under: "Decision > Database".
  heading        String                       @default("")
  ordinal        Int
  text           String
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  dateCreated    DateTime                     @default(now())

  @@index([topicSourceId, path])
  @@index([topicSourceId, documentId])
  @@index([topicId])
  @@map("TopicPassages")
}

enum TopicBackfillStatus {
  /// Finding the topic's past emails and documents, and what reading them would cost.
  ESTIMATING
  /// Waiting for the user to start it.
  ESTIMATED
  /// The cheap model's batch: which of them state anything worth remembering.
  SCREENING
  /// The writing model's batch: the proposals.
  PROPOSING
  /// The proposals wait for the user.
  REVIEW
  DONE
  FAILED
  CANCELLED
}

/**
 * Reading a topic's history for facts (M43-T5, docs/design.md §8.1): its past emails (found by its exact directions and
 * threads) and its sources' indexed documents. An estimate first; then, once the user starts it, two Batch API passes
 * at half the price; the proposals wait for the user. Emails by their ids only: their text is read from the mailbox
 * when the batch is built.
 */
model TopicBackfill {
  topicBackfillId String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId         String              @db.Uuid
  topic           Topic               @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  /// How far back, in months.
  months          Int
  /// The documents indexed from the topic's sources too.
  documents       Boolean             @default(true)
  status          TopicBackfillStatus @default(ESTIMATING)
  /// The emails found: [{ messageId, date }].
  emails          Json                @default("[]")
  /// The documents: [{ topicSourceId, path }].
  files           Json                @default("[]")
  estimateUsd     Float?
  /// The screen's answer: which of emails, then files (by index), are worth the writing model.
  worth           Json?
  batchId         String?
  /// The proposals (TopicProposal), for the user to pick.
  proposals       Json                @default("[]")
  applied         Int                 @default(0)
  llmUsage        Json?
  error           String?
  dateCreated     DateTime            @default(now())
  finishedAt      DateTime?

  @@index([topicId, dateCreated])
  @@index([userId, status])
  @@map("TopicBackfills")
}

enum TopicSuggestionKind {
  /// A direction for a topic (payload: { kind, value, about }).
  DIRECTION
  /// A new topic (payload: { name, description, directions }).
  TOPIC
  /// A fact for a topic (payload: a TopicProposal).
  FACT
}

enum TopicSuggestionStatus {
  OPEN
  ACCEPTED
  /// The user said no: the same suggestion isn't made again.
  DISMISSED
}

/**
 * What Storm suggests from the user's decisions and edits (M44, docs/design.md §8.1): a direction, a topic, a fact.
 * Nothing suggested is active before the user accepts it; a dismissed one isn't suggested again (its `key`).
 */
model TopicSuggestion {
  topicSuggestionId String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  user              User                  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// DIRECTION, FACT: the topic it is for.
  topicId           String?               @db.Uuid
  topic             Topic?                @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  kind              TopicSuggestionKind
  /// What makes it the same suggestion again: "DIRECTION:<topicId>:PERSON:ivan@client.example".
  key               String
  payload           Json
  /// Why, in one line: "you confirmed 6 of their emails for Billing".
  reason            String
  status            TopicSuggestionStatus @default(OPEN)
  dateCreated       DateTime              @default(now())
  decidedAt         DateTime?

  @@unique([userId, key])
  @@index([userId, status])
  @@map("TopicSuggestions")
}

/**
 * What a topic's upkeep cost (M44-T5), by day and step type: the topic steps' LLM and embedding calls shared out among
 * the topics they were for. Only to show where the money went (its page, the weekly review): the budget counts the
 * steps themselves.
 */
model TopicCost {
  topicCostId String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topicId     String   @db.Uuid
  topic       Topic    @relation(fields: [topicId], references: [topicId], onDelete: Cascade)
  day         DateTime @db.Date
  /// The step type: topic.match, topic.extract, topic.index, topic.attachments, topic.tidy.
  source      String
  costUsd     Float    @default(0)

  @@unique([topicId, day, source])
  @@index([userId, day])
  @@map("TopicCosts")
}

/**
 * A triaged email that belonged to no topic (M44-T2, docs/design.md §8.1): what the nightly reflection looks at for a
 * subject the user may want a topic for. Its ids, sender, subject and date only, never its text; kept 30 days.
 */
model UnlinkedEmail {
  unlinkedEmailId String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  messageId       String
  from            String
  subject         String
  date            DateTime
  dateCreated     DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId, date])
  @@map("UnlinkedEmails")
}
