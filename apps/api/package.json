{
  "name": "@ai-me/api",
  "version": "0.1.0",
  "private": true,
  "description": "AI ME API: auth, credentials (encrypt only), and later pipelines, proposals and runs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "clean": "rimraf dist",
    "auth:setup": "tsx src/tools/auth-setup.ts"
  },
  "dependencies": {
    "@ai-me/crypto": "workspace:*",
    "@ai-me/db": "workspace:*",
    "@ai-me/llm": "workspace:*",
    "@ai-me/queue": "workspace:*",
    "@ai-me/shared": "workspace:*",
    "@ai-me/steps": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/throttler": "catalog:",
    "argon2": "catalog:",
    "cookie-parser": "catalog:",
    "dotenv": "catalog:",
    "helmet": "catalog:",
    "otplib": "catalog:",
    "qrcode": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-me/config": "workspace:*",
    "@ai-me/testing": "workspace:*",
    "@eslint/js": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
