{
  "name": "@ai-me/worker",
  "version": "0.1.0",
  "private": true,
  "description": "AI ME worker: the only place credentials are decrypted; later the pipeline runner and step implementations",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "clean": "rimraf dist",
    "keys:rotate": "tsx src/tools/rotate-keys.ts"
  },
  "dependencies": {
    "@ai-me/crypto": "workspace:*",
    "@ai-me/db": "workspace:*",
    "@ai-me/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "dotenv": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "catalog:"
  },
  "devDependencies": {
    "@ai-me/config": "workspace:*",
    "@ai-me/testing": "workspace:*",
    "@eslint/js": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
