{
  "name": "@realentity/storm-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Storm worker: the only place credentials are decrypted; later the pipeline runner and step implementations",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test evals",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "clean": "rimraf dist",
    "keys:rotate": "tsx src/tools/rotate-keys.ts",
    "check:credentials": "tsx src/tools/check-credentials.ts",
    "eval:email": "tsx evals/email.eval.ts",
    "eval:learning": "tsx evals/learning.eval.ts",
    "eval:forms": "tsx evals/forms.eval.ts",
    "eval:agent": "tsx evals/agent.eval.ts"
  },
  "dependencies": {
    "@realentity/storm-crypto": "workspace:*",
    "@realentity/storm-db": "workspace:*",
    "@realentity/storm-llm": "workspace:*",
    "@realentity/storm-queue": "workspace:*",
    "@realentity/storm-shared": "workspace:*",
    "@realentity/storm-steps": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "dotenv": "catalog:",
    "imapflow": "catalog:",
    "jsonata": "catalog:",
    "mailparser": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "fast-xml-parser": "catalog:",
    "pdf-parse": "catalog:",
    "playwright": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@realentity/storm-config": "workspace:*",
    "@realentity/storm-testing": "workspace:*",
    "@eslint/js": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
