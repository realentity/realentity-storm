# Copy to .env (one file in the repository root, shared by api, worker and packages/db).
# Later milestones add more keys; see README §14 for the full list.

# Database
DATABASE_URL=postgresql://aime:change-me@localhost:5432/aime
POSTGRES_PASSWORD=change-me

# Encryption: 32 random bytes: openssl rand -hex 32 (or -base64 32)
# BACK THIS UP SEPARATELY from database backups. Losing it = losing all stored credentials.
# Rotation: add ENCRYPTION_KEY_V2, set ENCRYPTION_KEY_VERSION=2, run pnpm keys:rotate.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# API
API_HOST=127.0.0.1
API_PORT=3000

# App auth (single user). Generate the hash and TOTP secret with: pnpm auth:setup
APP_ADMIN_EMAIL=me@localhost
APP_ADMIN_PASSWORD_HASH=
APP_TOTP_SECRET=
SESSION_TTL_HOURS=168
