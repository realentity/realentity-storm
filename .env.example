# Copy to .env (one file in the repository root, shared by api, worker and packages/db).
# Later milestones add more keys; see README §14 for the full list.

# Database
DATABASE_URL=postgresql://aime:change-me@localhost:5432/aime
POSTGRES_PASSWORD=change-me

# Encryption: 32 random bytes: openssl rand -hex 32 (or -base64 32)
# BACK THIS UP SEPARATELY from database backups. Losing it = losing all stored credentials.
# Rotation: add ENCRYPTION_KEY_V2, set ENCRYPTION_KEY_VERSION=2, run pnpm keys:rotate.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# LLM (Claude API). Models per task group default to claude-haiku-5-5 (classify, score) and
# claude-sonnet-5-5 (generate, summarize); Settings override them per step type.
ANTHROPIC_API_KEY=
LLM_MODEL_CLASSIFY=
LLM_MODEL_WRITING=
# Non-essential pipelines pause when this month's LLM cost reaches it; Settings override it; empty = no limit
LLM_MONTHLY_BUDGET_USD=

# API
API_HOST=127.0.0.1
API_PORT=3000
# The address the browser uses, when behind a proxy (server: https://storm.example.com:8100); empty in development
APP_ORIGIN=

# App auth (single user). Generate the hash and TOTP secret with: pnpm auth:setup
APP_ADMIN_EMAIL=me@localhost
APP_ADMIN_PASSWORD_HASH=
APP_TOTP_SECRET=
SESSION_TTL_HOURS=168

# notify.telegram: a bot from @BotFather, and my chat id (messages go to this chat only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail (email.* steps): IMAP/SMTP. The address and the Google app password are a credential on the Credentials
# page (default name "mail"; username = the address; allowed hosts = both servers). Nothing secret goes here.
MAIL_CONNECTOR=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_TLS=true
MAIL_CREDENTIAL=mail
