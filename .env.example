# Copy to .env (one file in the repository root, shared by api, worker and packages/db).
# Later milestones add more keys; see docs/design.md §14 for the full list.

# Database. The default is the PostgreSQL container of STORM_LOCAL=1 (docker/compose.local.yml): fine for trying
# Storm, since it is reachable only inside Docker; use a PostgreSQL of your own with a strong password for real use.
# pnpm dev (Node on this machine, docker/docker-compose.yml's postgres): postgresql://aime:aime@localhost:5432/aime
DATABASE_URL=postgresql://aime:aime@postgres:5432/aime
POSTGRES_PASSWORD=aime

# Encryption: 32 random bytes: openssl rand -hex 32 (or -base64 32)
# BACK THIS UP SEPARATELY from database backups. Losing it = losing all stored credentials.
# Rotation: add ENCRYPTION_KEY_V2, set ENCRYPTION_KEY_VERSION=2, run pnpm keys:rotate.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# LLM (Claude API). Models per task group default to claude-haiku-5-5 (classify, score) and
# claude-sonnet-5-5 (generate, summarize); Settings override them per step type.
ANTHROPIC_API_KEY=
LLM_MODEL_CLASSIFY=
LLM_MODEL_WRITING=
# The nightly reflection (suggested rules from your edits): claude-opus-5-5 through the Batch API by default
LLM_MODEL_REFLECTION=
# The builder chat (describe or change a pipeline): claude-opus-5-5 by default. A chat stops at this many tokens
LLM_MODEL_BUILDER=
BUILDER_CHAT_MAX_TOKENS=2000000
# Non-essential pipelines pause when this month's LLM cost reaches it; Settings override it; empty = no limit
LLM_MONTHLY_BUDGET_USD=

# Embeddings for few-shot examples in drafts (OpenAI, 1024 dimensions). Empty: drafts are written without examples
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-large

# API
API_HOST=127.0.0.1
API_PORT=3000
# The address you open Storm at, for the links Storm sends (Telegram, browser takeovers) and the Google redirect:
# http://localhost:7100 with Docker on this machine (STORM_PORT below), https://storm.example.com behind a proxy.
# Empty for pnpm dev (the address of each request is used).
APP_ORIGIN=

# App auth (single user). Generate the hash and TOTP secret with: pnpm auth:setup
APP_ADMIN_EMAIL=me@localhost
APP_ADMIN_PASSWORD_HASH=
APP_TOTP_SECRET=
SESSION_TTL_HOURS=168

# Browser (browser.* steps). Screenshots, traces and downloads go to ARTIFACTS_DIR (the worker image: /data/artifacts).
ARTIFACTS_DIR=data/artifacts
# Run files older than this are deleted nightly (the runs stay); 0 keeps them
ARTIFACTS_RETENTION_DAYS=90
# Your documents (CV, cover letters) that application forms attach (Profile page); the compose files set /data/documents
DOCUMENTS_DIR=data/documents
# The live view: x11vnc's passwords, full control and view-only (input is ignored on it). VNC uses the first 8
# characters: openssl rand -base64 6. Empty: no live view (headed runs still work, unwatched).
VNC_PASSWORD=
VNC_VIEW_PASSWORD=
# A run waiting for you in the live view gives up after this long; downloads over this size are rejected
TAKEOVER_TIMEOUT_MINUTES=30
DOWNLOAD_MAX_MB=25

# The Storm bot (docs/design.md §2.7): a bot from @BotFather, and your Telegram user id (= your private chat with it; messages
# go there only, commands and buttons are taken only from it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The secret_token its webhook was registered with (a gateway in front may check it too); empty: /hooks/telegram
# answers nothing. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Public address of the webhooks, shown on the pipeline page, e.g. https://hooks.example.com/hooks (docs/self-hosting.md)
HOOKS_PUBLIC_URL=
# What the host's own jobs (backup, restore test, health checks) send with their reports to /hooks/health (M26);
# empty: the endpoint answers nothing. openssl rand -hex 32
HEALTH_REPORT_TOKEN=

# Google Calendar (calendar.* steps): a Web application OAuth client of your Google Cloud project, whose redirect URI
# is APP_ORIGIN + /api/google/callback (Settings shows it). Then Settings -> Connect Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (email.* steps): IMAP/SMTP. The address and the Google app password are a credential on the Credentials
# page (default name "mail"; username = the address; allowed hosts = both servers). Nothing secret goes here.
MAIL_CONNECTOR=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_TLS=true
MAIL_CREDENTIAL=mail

# Docker (./docker/storm, docs/self-hosting.md): where the containers keep their files (artifacts/ and documents/,
# owned by uid 1000; empty: the repository's data/), the ports they publish on 127.0.0.1, the folder with the
# database dumps the restore test reads (<database>-*.dump)
STORM_DATA_DIR=
STORM_PORT=7100
STORM_HOOKS_PORT=7101
STORM_DUMPS=

# Your time zone (Node follows TZ): schedules without a tz of their own, the morning brief, the weekly review and the
# system jobs use it. Empty: the host's zone (UTC in the containers). An IANA name:
# TZ=Europe/London
