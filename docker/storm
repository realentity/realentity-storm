#!/usr/bin/env bash
# Storm's docker compose, from anywhere in the repository (docs/deployment.md).
#   ./docker/storm up             build and start (or update) everything
#   ./docker/storm check          every credential opens with this ENCRYPTION_KEY (values are never printed)
#   ./docker/storm restore-test   last night's dump restored into a test database and checked; the result on Telegram (M18-T4)
#   ./docker/storm <args>         passed to docker compose: ps, logs -f worker, restart worker, down, ...
# STORM_LOCAL=1 adds compose.local.yml (a PostgreSQL container, for testing on a workstation).
set -euo pipefail
# Git Bash on Windows (local tests): a native path (pwd -W), and no rewriting of container paths.
here="$(cd "$(dirname "$0")" && (pwd -W 2>/dev/null || pwd))"
export MSYS_NO_PATHCONV=1

files=(-f "$here/compose.yml")
[ "${STORM_LOCAL:-0}" = "1" ] && files+=(-f "$here/compose.local.yml")
compose() { docker compose "${files[@]}" "$@"; }

# A value from .env, never printed.
env_value() { grep -m1 "^$1=" "$here/../.env" | cut -d= -f2- | sed 's/^"//; s/"$//'; }

# A result for Storm's Health page (M26): POST /hooks/health on the hooks-only site, with HEALTH_REPORT_TOKEN; Storm
# alerts once per problem. Without the token (or Storm down), the result goes to Telegram directly.
#   report <name> <ok: true|false> <detail> [maxAgeHours]
report() {
  local token body
  token="$(env_value HEALTH_REPORT_TOKEN || true)"
  body="$(printf '{"name":"%s","ok":%s,"detail":"%s","maxAgeHours":%s}' "$1" "$2" "$(printf '%s' "$3" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ' | cut -c1-1900)" "${4:-26}")"
  if [ -n "$token" ] && curl -fsS -o /dev/null --max-time 20 -X POST -H "content-type: application/json" \
    -H "x-storm-health-token: $token" --data "$body" "${STORM_HOOKS:-http://127.0.0.1:7101}/hooks/health"; then
    return 0
  fi
  if [ "$2" = "true" ]; then tell "Storm $1 passed: $3"; else tell "Storm $1 FAILED: $3"; fi
}

# The result on Telegram (the Storm bot), when it is set up.
tell() {
  local token chat
  token="$(env_value TELEGRAM_BOT_TOKEN || true)"
  chat="$(env_value TELEGRAM_CHAT_ID || true)"
  [ -n "$token" ] && [ -n "$chat" ] || return 0
  curl -s -o /dev/null --max-time 20 --data-urlencode "chat_id=$chat" --data-urlencode "text=$1" \
    "https://api.telegram.org/bot$token/sendMessage" || true
}

# The restore test of docs/deployment.md as one command: the newest nightly dump (or $2) into storm_restore_test,
# the counts against the live database, the credentials opened with this ENCRYPTION_KEY, the test database dropped.
# The restore test runs on the 1st: a report older than a month and a few days means it stopped.
MONTH_HOURS=$((35 * 24))

restore_test() {
  local dumps="${STORM_DUMPS:-/var/backups/postgres}" db=storm_restore_test dump age problems=()
  dump="${1:-$(ls -1t "$dumps"/storm-*.dump 2>/dev/null | head -n1 || true)}"
  if [ -z "$dump" ] || [ ! -f "$dump" ]; then
    report restore-test false "no dump in $dumps" "$MONTH_HOURS"
    echo "No dump in $dumps" >&2
    return 1
  fi
  age=$(( ($(date +%s) - $(stat -c %Y "$dump")) / 86400 ))
  [ "$age" -gt 2 ] && problems+=("the newest dump is $age days old: is the nightly backup running?")

  sql() { sudo -u postgres psql -v ON_ERROR_STOP=1 -qtA "$@"; }
  sudo -u postgres dropdb --if-exists "$db"
  trap 'sudo -u postgres dropdb --if-exists storm_restore_test || true' EXIT
  sudo -u postgres createdb -O storm_user "$db"
  sql -d "$db" -c 'CREATE EXTENSION vector;' -c 'CREATE EXTENSION citext;'
  # The dumps are root's (the nightly backup's): read here, given to pg_restore on stdin.
  if ! sudo -u postgres pg_restore -d "$db" --no-owner --no-comments --role=storm_user --exit-on-error < "$dump"; then
    report restore-test false "pg_restore failed for $(basename "$dump")" "$MONTH_HOURS"
    echo "pg_restore failed for $dump" >&2
    return 1
  fi

  # The dump's schema: a deploy after it adds tables (and rows) the dump can't have.
  local latest='SELECT migration_name FROM _prisma_migrations WHERE finished_at IS NOT NULL ORDER BY migration_name DESC LIMIT 1;'
  local dumped current schema
  dumped="$(sql -d "$db" -c "$latest" 2>/dev/null || echo "?")"
  current="$(sql -d storm -c "$latest" 2>/dev/null || echo "?")"
  [ "$dumped" = "?" ] && problems+=("the dump has no migrations table")
  if [ "$dumped" = "$current" ]; then schema="schema $dumped"; else schema="schema $dumped (live: $current, migrated since)"; fi

  # The tables there since M2, which a working install never has empty; the rest are shown, not checked.
  local table restored live counts=()
  for table in Pipelines Runs Credentials Facts Applications; do
    restored="$(sql -d "$db" -c "SELECT count(*) FROM \"$table\";" 2>/dev/null || echo "-")"
    live="$(sql -d storm -c "SELECT count(*) FROM \"$table\";" 2>/dev/null || echo "-")"
    counts+=("$table $restored/$live")
    case "$table" in Pipelines | Runs | Credentials) ;; *) continue ;; esac
    [ "$restored" = "-" ] && problems+=("$table is missing from the dump")
    [ "$restored" = "0" ] && [ "$live" != "0" ] && problems+=("$table is empty in the dump")
  done

  local url credentials
  url="$(env_value DATABASE_URL | sed 's|/storm$|/'"$db"'|')"
  local status=0
  credentials="$(compose run --rm --no-deps -e DATABASE_URL="$url" worker node dist/tools/check-credentials.js 2>&1)" || status=$?
  # Only the tool's own lines: compose adds "Container … Creating" and the like.
  credentials="$(printf '%s\n' "$credentials" | grep -v '^ *Container ' || true)"
  [ "$status" -eq 0 ] || problems+=("credentials: ${credentials##*$'\n'}")

  local summary
  summary="$(basename "$dump"), $schema; restored/live: ${counts[*]}. ${credentials%%$'\n'*}"
  echo "$summary"
  if [ "${#problems[@]}" -gt 0 ]; then
    printf '  %s\n' "${problems[@]}" >&2
    local joined
    joined="$(printf '%s; ' "${problems[@]}")"
    report restore-test false "${joined%; }. $summary" "$MONTH_HOURS"
    return 1
  fi
  report restore-test true "$summary" "$MONTH_HOURS"
}

case "${1:-}" in
  up)
    shift
    compose up -d --build --remove-orphans "$@"
    compose ps
    ;;
  check)
    compose exec worker node dist/tools/check-credentials.js
    ;;
  restore-test)
    shift
    restore_test "$@"
    ;;
  *)
    compose "$@"
    ;;
esac
