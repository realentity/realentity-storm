#!/bin/sh
# Secrets never get committed: gitleaks scans what is staged (.gitleaks.toml). Without gitleaks installed it warns
# and lets the commit through; CI scans every push anyway. Install: https://github.com/gitleaks/gitleaks#installing
gitleaks_bin="$(command -v gitleaks 2>/dev/null)"
if [ -z "$gitleaks_bin" ] && [ -n "$LOCALAPPDATA" ]; then
  # Windows: winget installs it outside PATH for Git Bash.
  for g in "$(cygpath -u "$LOCALAPPDATA" 2>/dev/null)"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    [ -x "$g" ] && gitleaks_bin="$g"
  done
fi
if [ -z "$gitleaks_bin" ]; then
  echo "pre-commit: gitleaks is not installed; the staged changes were not scanned for secrets." >&2
  exit 0
fi
exec "$gitleaks_bin" git --staged --no-banner --redact --log-level error --config .gitleaks.toml
